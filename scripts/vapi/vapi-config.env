#
# VAPI Configuration
#
# This file contains VAPI-specific configuration for the ProjectForce
# voice integration.
#
# DO NOT commit API keys to version control!
# Set VAPI_PRIVATE_KEY as an environment variable instead.
#

# ========================================
# VAPI Assistant IDs
# ========================================
# These are the VAPI assistant IDs for each environment

# Dev Assistant
export VAPI_ASSISTANT_DEV="2b437308-b93e-4da6-a2f1-ffbf422d5298"

# Prod Assistant
export VAPI_ASSISTANT_PROD="fa7fd950-dd7b-4900-9e92-4d8bc2c7342f"

# ========================================
# VAPI Organization
# ========================================
export VAPI_ORG_ID="9bc7e827-d48a-4c28-ab51-e4c3284116cc"

# ========================================
# Lambda Configuration
# ========================================
# VAPI webhook Lambda names
export VAPI_WEBHOOK_LAMBDA_DEV="pf-syn-vapi-webhook-dev"
export VAPI_WEBHOOK_LAMBDA_PROD="pf-syn-vapi-webhook-prod"

# Lambda deploy region (voice region)
export VAPI_LAMBDA_REGION="us-east-1"

# ========================================
# Twilio Configuration
# ========================================
export TWILIO_PHONE_NUMBER="+12185516488"

# ========================================
# API Keys (DO NOT COMMIT!)
# ========================================
# Set these as environment variables, not in this file:
#
# export VAPI_PRIVATE_KEY="your-private-key"
# export VAPI_PUBLIC_KEY="your-public-key"
#
# Private key: Used for API mutations (PATCH, POST, DELETE)
# Public key: Used for client-side operations
