# =============================================================================
# resources.env - ProjectForce Scheduling Agent Configuration
# =============================================================================
# This file contains environment-specific configuration values.
# Modify these values when deploying to different environments or accounts.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Configuration - Multi-Region Setup
# -----------------------------------------------------------------------------
# CORE_REGION: Main processing (orchestrator, action Lambdas, API Gateway, DynamoDB, Bedrock)
# VOICE_REGION: Voice/SMS entry points (Connect, Lex, lex-fulfillment, sms-inbound)
# SECRETS_REGION: Where Secrets Manager credentials are stored
#
# This dual-region setup is required because:
# - Amazon Connect and your phone numbers are provisioned in us-east-1
# - Your pf-aws profile defaults to us-east-2 for other AWS services
#
export CORE_REGION="${CORE_REGION:-us-east-2}"
export VOICE_REGION="${VOICE_REGION:-us-east-1}"
export SECRETS_REGION="${SECRETS_REGION:-us-east-2}"
export AWS_REGION="${AWS_REGION:-$CORE_REGION}"
export EXPECTED_ACCOUNT="772634497954"
export AWS_PROFILE_DEFAULT="pf-aws"

# -----------------------------------------------------------------------------
# Resource Naming Configuration
# -----------------------------------------------------------------------------
# PREFIX: Added to all resource names (e.g., "pf-syn" -> pf-syn-orchestrator-dev)
# ENVIRONMENT: Suffix for all resources (dev, qa, prod)
#
# Usage: ./pf-manage.sh deploy --all --prefix pf-syn --env dev
# Result: Resources named as ${PREFIX}-${resource}-${ENVIRONMENT}
#
export RESOURCE_PREFIX="${RESOURCE_PREFIX:-pf-syn}"
export ENVIRONMENT="${ENVIRONMENT:-prod}"

# Valid environments (for validation)
export VALID_ENVIRONMENTS="dev qa prod"

# -----------------------------------------------------------------------------
# Environment Settings
# -----------------------------------------------------------------------------
export USE_MOCK_API="false"
export DEFAULT_CLIENT_ID="09PF05VD"

# -----------------------------------------------------------------------------
# Lambda Function Configuration
# -----------------------------------------------------------------------------
# Format: NAME:SOURCE_DIR:ROLE:TIMEOUT:MEMORY

# Core Lambda Functions
export LAMBDA_ORCHESTRATOR_TIMEOUT=120
export LAMBDA_ORCHESTRATOR_MEMORY=512

export LAMBDA_ACTIONS_TIMEOUT=60
export LAMBDA_ACTIONS_MEMORY=1769

# Voice Lambda Functions
export LAMBDA_LEX_FULFILLMENT_TIMEOUT=60
export LAMBDA_LEX_FULFILLMENT_MEMORY=512

export LAMBDA_CUSTOMER_LOOKUP_TIMEOUT=30
export LAMBDA_CUSTOMER_LOOKUP_MEMORY=256

export LAMBDA_VOICE_BRIDGE_TIMEOUT=120
export LAMBDA_VOICE_BRIDGE_MEMORY=512

# SMS Lambda Functions
export LAMBDA_SMS_INBOUND_TIMEOUT=60
export LAMBDA_SMS_INBOUND_MEMORY=512

# -----------------------------------------------------------------------------
# DynamoDB Table Names (dynamically constructed)
# -----------------------------------------------------------------------------
# These are base names - actual names will be: ${PREFIX}-${base}-${ENV}
export DYNAMODB_SESSIONS_BASE="sessions"
export DYNAMODB_NOTES_BASE="notes"
export DYNAMODB_WORKFLOW_BASE="workflow-states"
export DYNAMODB_CUSTOMERS_BASE="customers"
export DYNAMODB_SMS_SESSIONS_BASE="sms-sessions"
export DYNAMODB_SMS_CONSENT_BASE="sms-consent"
export DYNAMODB_SMS_MESSAGES_BASE="sms-messages"
export DYNAMODB_OPT_OUT_TRACKING_BASE="opt-out-tracking"

# -----------------------------------------------------------------------------
# Lex Bot Configuration
# -----------------------------------------------------------------------------
# Base name - actual: ${PREFIX}-scheduling-assistant-${ENV}
export LEX_BOT_BASE="scheduling-assistant"
export LEX_BOT_ALIAS="TestBotAlias"
export LEX_BOT_LOCALE="en_US"

# -----------------------------------------------------------------------------
# Connect Configuration
# -----------------------------------------------------------------------------
# Base name - actual: ${PREFIX}-schedule-voice-${ENV}
export CONNECT_INSTANCE_BASE="schedule-voice"
export VOICE_PHONE_NUMBER="+18447845789"

# -----------------------------------------------------------------------------
# SMS Configuration
# -----------------------------------------------------------------------------
export SMS_PHONE_NUMBER="+18786789053"
# Base name - actual: ${PREFIX}-sms-inbound-${ENV}
export SNS_TOPIC_BASE="sms-inbound"

# -----------------------------------------------------------------------------
# VAPI/Twilio Voice Configuration
# -----------------------------------------------------------------------------
export TWILIO_PHONE_NUMBER="+12185516488"

# -----------------------------------------------------------------------------
# Secrets Manager
# -----------------------------------------------------------------------------
export SECRETS_NAME="projectforce/api/credentials"

# -----------------------------------------------------------------------------
# Bedrock Configuration
# -----------------------------------------------------------------------------
export BEDROCK_MODEL_ID="us.anthropic.claude-3-5-sonnet-20241022-v2:0"
export BEDROCK_REGION="us-east-2"

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
export PF_API_BASE_URL="https://api.projectsforce.com"

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
export LOG_LEVEL="INFO"
export CLOUDWATCH_LOG_RETENTION_DAYS=14
