{
  "Version": "2019-10-30",
  "StartAction": "entry-action",
  "Metadata": {
    "entryPointPosition": { "x": 40, "y": 229 },
    "ActionMetadata": {
      "entry-action": {
        "position": { "x": 40, "y": 229 }
      },
      "set-voice-action": {
        "position": { "x": 200, "y": 200 }
      },
      "play-prompt-action": {
        "position": { "x": 450, "y": 150 }
      },
      "get-customer-input-1": {
        "position": { "x": 720, "y": 50 },
        "isFriendlyName": true,
        "parameters": {
          "LexV2Bot": {
            "AliasArn": {
              "displayName": "TestBotAlias",
              "useLexBotDropdown": true,
              "lexV2BotName": "pf-scheduling-assistant-dev"
            }
          }
        },
        "useLexBotDropdown": true,
        "lexV2BotName": "pf-scheduling-assistant-dev",
        "lexV2BotAliasName": "TestBotAlias",
        "conditionMetadata": [
          {"id": "cond-goodbye", "value": "Goodbye"},
          {"id": "cond-nothing-much", "value": "nothing much"},
          {"id": "cond-all-done", "value": "all done"},
          {"id": "cond-thanks", "value": "Thanks"},
          {"id": "cond-fallback", "value": "FallbackIntent"}
        ]
      },
      "loop-action": {
        "position": { "x": 950, "y": 400 }
      },
      "disconnect-action": {
        "position": { "x": 1250, "y": 120 }
      }
    }
  },
  "Actions": [
    {
      "Identifier": "entry-action",
      "Type": "Trigger",
      "Parameters": {},
      "Transitions": {
        "NextAction": "set-voice-action"
      }
    },
    {
      "Identifier": "set-voice-action",
      "Type": "UpdateContactTextToSpeechVoice",
      "Parameters": {
        "TextToSpeechVoice": "Joanna",
        "TextToSpeechEngine": "Neural"
      },
      "Transitions": {
        "NextAction": "play-prompt-action",
        "Errors": [
          {
            "NextAction": "disconnect-action",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "play-prompt-action",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Thank you for calling. How can I help you today?"
      },
      "Transitions": {
        "NextAction": "get-customer-input-1",
        "Errors": [
          {
            "NextAction": "disconnect-action",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "get-customer-input-1",
      "Type": "ConnectParticipantWithLexBot",
      "Parameters": {
        "LexBot": {
          "Name": "pf-scheduling-assistant",
          "Region": "${REGION}",
          "AliasArn": "arn:aws:lex:${REGION}:${ACCOUNT_ID}:bot-alias/${BOT_ID}/${ALIAS_ID}"
        },
        "LexSessionAttributes": {}
      },
      "Transitions": {
        "NextAction": "loop-action",
        "Conditions": [
          {
            "NextAction": "disconnect-action",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["Goodbye"]
            }
          },
          {
            "NextAction": "disconnect-action",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["nothing much"]
            }
          },
          {
            "NextAction": "disconnect-action",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["all done"]
            }
          },
          {
            "NextAction": "disconnect-action",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["Thanks"]
            }
          },
          {
            "NextAction": "loop-action",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["FallbackIntent"]
            }
          }
        ],
        "Errors": [
          {
            "NextAction": "disconnect-action",
            "ErrorType": "NoMatchingError"
          },
          {
            "NextAction": "disconnect-action",
            "ErrorType": "NoMatchingCondition"
          }
        ]
      }
    },
    {
      "Identifier": "loop-action",
      "Type": "Loop",
      "Parameters": {
        "LoopCount": "20"
      },
      "Transitions": {
        "NextAction": "disconnect-action",
        "Conditions": [
          {
            "NextAction": "get-customer-input-1",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["ContinueLooping"]
            }
          },
          {
            "NextAction": "disconnect-action",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["DoneLooping"]
            }
          }
        ]
      }
    },
    {
      "Identifier": "disconnect-action",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
