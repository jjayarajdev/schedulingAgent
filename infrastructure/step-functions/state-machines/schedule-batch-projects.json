{
  "Comment": "Batch Scheduling Workflow - Schedules multiple projects in parallel with optimization",
  "StartAt": "GetAllProjects",
  "States": {
    "GetAllProjects": {
      "Type": "Task",
      "Comment": "Get all customer projects",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "pf-information-actions",
        "Payload": {
          "apiPath": "/get_projects",
          "httpMethod": "POST",
          "parameters": [
            {
              "name": "customer_id",
              "value.$": "$.customer_id"
            }
          ]
        }
      },
      "ResultPath": "$.projectsResponse",
      "Next": "ParseProjectsResponse",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleGetProjectsError",
          "ResultPath": "$.error"
        }
      ]
    },

    "ParseProjectsResponse": {
      "Type": "Pass",
      "Comment": "Extract projects list from Lambda response",
      "Parameters": {
        "projects.$": "$.projectsResponse.Payload.response.responseBody.application/json.body",
        "customer_id.$": "$.customer_id",
        "client_id.$": "$.client_id",
        "sessionId.$": "$.sessionId",
        "query.$": "$.query",
        "filterCriteria.$": "$.filterCriteria"
      },
      "Next": "ParseProjectsJSON"
    },

    "ParseProjectsJSON": {
      "Type": "Pass",
      "Comment": "Parse the JSON string to extract projects array",
      "Parameters": {
        "projectsData.$": "States.StringToJson($.projects)",
        "customer_id.$": "$.customer_id",
        "client_id.$": "$.client_id",
        "sessionId.$": "$.sessionId",
        "query.$": "$.query",
        "filterCriteria.$": "$.filterCriteria"
      },
      "Next": "FilterProjectsByCriteria"
    },

    "FilterProjectsByCriteria": {
      "Type": "Task",
      "Comment": "Filter projects based on batch criteria (status, priority, type)",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "pf-filter-projects",
        "Payload": {
          "projects.$": "$.projectsData.projects",
          "filterCriteria.$": "$.filterCriteria.type",
          "filterValue.$": "$.filterCriteria.value"
        }
      },
      "ResultPath": "$.filterResult",
      "Next": "ParseFilterResult"
    },

    "ParseFilterResult": {
      "Type": "Pass",
      "Comment": "Parse filter result from JSON string",
      "Parameters": {
        "filterData.$": "States.StringToJson($.filterResult.Payload.body)",
        "customer_id.$": "$.customer_id",
        "client_id.$": "$.client_id",
        "sessionId.$": "$.sessionId",
        "query.$": "$.query"
      },
      "Next": "CheckIfProjectsFound"
    },

    "CheckIfProjectsFound": {
      "Type": "Choice",
      "Comment": "Check if we found projects to schedule",
      "Choices": [
        {
          "Variable": "$.filterData.count",
          "NumericGreaterThan": 0,
          "Next": "LimitProjectCount"
        }
      ],
      "Default": "NoProjectsFound"
    },

    "LimitProjectCount": {
      "Type": "Pass",
      "Comment": "Pass all projects (limit handling done in application logic)",
      "Parameters": {
        "projects.$": "$.filterData.filteredProjects",
        "totalCount.$": "$.filterData.count",
        "customer_id.$": "$.customer_id",
        "client_id.$": "$.client_id",
        "sessionId.$": "$.sessionId"
      },
      "Next": "PrepareForBatchScheduling"
    },

    "PrepareForBatchScheduling": {
      "Type": "Pass",
      "Comment": "Prepare batch scheduling data",
      "Parameters": {
        "projectsToSchedule.$": "$.projects",
        "projectCount.$": "States.ArrayLength($.projects)",
        "totalAvailable.$": "$.totalCount",
        "customer_id.$": "$.customer_id",
        "client_id.$": "$.client_id",
        "sessionId.$": "$.sessionId",
        "schedulingResults": []
      },
      "Next": "FormatBatchResponse"
    },

    "FormatBatchResponse": {
      "Type": "Pass",
      "Comment": "Format response for batch scheduling",
      "Parameters": {
        "success": true,
        "batch_scheduling": true,
        "projects_to_schedule.$": "$.projectsToSchedule",
        "project_count.$": "$.projectCount",
        "total_available.$": "$.totalAvailable",
        "message.$": "States.Format('Found {} projects ready for batch scheduling (out of {} total matching projects). Ready to schedule all at optimal times.', $.projectCount, $.totalAvailable)",
        "nextStep": "Please confirm to schedule all projects, or select specific projects to schedule.",
        "note": "Projects will be scheduled with optimal time slots to minimize gaps and travel time."
      },
      "End": true
    },

    "NoProjectsFound": {
      "Type": "Pass",
      "Comment": "No projects found matching criteria",
      "Parameters": {
        "success": false,
        "message": "No projects found matching your criteria. Please try different search criteria.",
        "suggestion": "You can search by status (pending, scheduled), priority (HIGH, MEDIUM, LOW), or type (installation, repair, etc.)"
      },
      "End": true
    },

    "HandleGetProjectsError": {
      "Type": "Pass",
      "Comment": "Handle error in getting projects",
      "Parameters": {
        "success": false,
        "error": "Failed to retrieve projects",
        "message": "I'm having trouble accessing your projects right now. Please try again in a moment.",
        "details.$": "$.error"
      },
      "End": true
    }
  }
}
