    "active": "in_progress",
    "working on": "in_progress",

    "completed": "completed",
    "done": "completed",
    "finished": "completed",

    "on hold": "on_hold",
    "waiting": "on_hold",
    "blocked": "on_hold",
    "pending": "on_hold",

    "cancelled": "cancelled",
