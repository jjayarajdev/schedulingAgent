{
  "version": "1.0",
  "description": "Project status configuration for voice assistant",

  "status_groups": {
    "schedulable": {
      "description": "Projects that can be scheduled",
      "statuses": [
        "New",
        "Ready To Schedule",
        "RTS",
        "Product Available",
        "Rescheduled",
        "Customer Rescheduled"
      ],
      "voice_phrase": "ready to schedule"
    },
    "scheduled": {
      "description": "Projects with confirmed appointments",
      "statuses": [
        "Scheduled",
        "Tentatively Scheduled",
        "Customer Scheduled",
        "Store Scheduled",
        "Install Scheduled",
        "HDMS scheduled"
      ],
      "voice_phrase": "scheduled"
    },
    "in_progress": {
      "description": "Projects currently being worked on",
      "statuses": [
        "In Progress",
        "In-Progress",
        "Installation In Progress",
        "Dispatched",
        "Issued to Field"
      ],
      "voice_phrase": "in progress"
    },
    "completed": {
      "description": "Finished projects",
      "statuses": [
        "Completed",
        "Work Complete",
        "Project Completed",
        "Work Order Completed",
        "Done",
        "Completed-Archived"
      ],
      "voice_phrase": "completed"
    },
    "on_hold": {
      "description": "Projects waiting on something",
      "statuses": [
        "On Hold",
        "Waiting for Product",
        "Waiting Product",
        "Missing Product",
        "Paused - Missing Product",
