    "ready to go": "schedulable",
    "ready": "schedulable",

    "scheduled": "scheduled",
    "on the books": "scheduled",
    "on the calendar": "scheduled",
    "booked": "scheduled",
    "appointments": "scheduled",

    "in progress": "in_progress",
