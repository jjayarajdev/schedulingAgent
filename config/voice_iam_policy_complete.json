{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VoiceLexBotManagement",
      "Effect": "Allow",
      "Action": [
        "lex:BuildBotLocale",
        "lex:DescribeBotLocale",
        "lex:DescribeCustomVocabularyMetadata",
        "lex:UpdateIntent",
        "lex:DescribeIntent",
        "lex:ListIntents",
        "lex:CreateSlot",
        "lex:UpdateSlot",
        "lex:DeleteSlot",
        "lex:ListSlots",
        "lex:DescribeSlot",
        "lex:DescribeBot",
        "lex:UpdateBotLocale",
        "lex:CreateIntent",
        "lex:DeleteIntent"
      ],
      "Resource": [
        "arn:aws:lex:us-east-1:772634497954:bot/WXFDD1TVEQ",
        "arn:aws:lex:us-east-1:772634497954:bot/WXFDD1TVEQ/*"
      ]
    },
    {
      "Sid": "VoiceLambdaManagement",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PublishVersion",
        "lambda:CreateAlias",
        "lambda:UpdateAlias",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy",
        "lambda:InvokeFunction",
        "lambda:PublishLayerVersion",
        "lambda:UpdateFunctionEventInvokeConfig"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:772634497954:function:pf-lex-fulfillment-dev",
        "arn:aws:lambda:us-east-1:772634497954:function:pf-voice-bedrock-bridge-dev",
        "arn:aws:lambda:us-east-1:772634497954:function:pf-customer-lookup-dev",
        "arn:aws:lambda:us-east-1:772634497954:layer:pf-common-layer-dev:*"
      ]
    },
    {
      "Sid": "VoiceIAMRoleManagement",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:GetRole"
      ],
      "Resource": [
        "arn:aws:iam::772634497954:role/pf-information-lambda-role-dev",
        "arn:aws:iam::772634497954:role/pf-voice-bedrock-bridge-role-dev",
        "arn:aws:iam::772634497954:role/pf-lex-fulfillment-role-dev",
        "arn:aws:iam::772634497954:role/pf-customer-lookup-role-dev"
      ]
    },
    {
      "Sid": "VoiceConnectManagement",
      "Effect": "Allow",
      "Action": [
        "connect:DescribeInstance",
        "connect:ListInstances",
        "connect:ListContactFlows",
        "connect:DescribeContactFlow",
        "connect:CreateContactFlow",
        "connect:UpdateContactFlow",
        "connect:UpdateContactFlowContent",
        "connect:ListPhoneNumbers",
        "connect:ListPhoneNumbersV2",
        "connect:UpdatePhoneNumber",
        "connect:AssociatePhoneNumberContactFlow",
        "connect:DescribePhoneNumber",
        "connect:ListIntegrationAssociations",
        "connect:ListLambdaFunctions",
        "connect:AssociateLambdaFunction"
      ],
      "Resource": [
        "arn:aws:connect:us-east-1:772634497954:instance/3edd99db-14e2-4628-836e-478b574e4b90",
        "arn:aws:connect:us-east-1:772634497954:instance/3edd99db-14e2-4628-836e-478b574e4b90/*"
      ]
    },
    {
      "Sid": "VoiceLogsAccess",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:StopQuery",
        "logs:GetQueryResults"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:772634497954:log-group:/aws/lambda/pf-*-dev:*",
        "arn:aws:logs:us-east-1:772634497954:log-group:/aws/connect/*:*",
        "arn:aws:logs:us-east-1:772634497954:log-group:/aws/lex/*:*"
      ]
    },
    {
      "Sid": "VoiceDynamoDBAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:ListTables",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:GetItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:772634497954:table/pf-customers-dev",
        "arn:aws:dynamodb:us-east-1:772634497954:table/pf-customers-dev/index/*",
        "arn:aws:dynamodb:us-east-1:772634497954:table/pf-sessions-dev",
        "arn:aws:dynamodb:us-east-1:772634497954:table/pf-sessions-dev/index/*"
      ]
    }
  ]
}
