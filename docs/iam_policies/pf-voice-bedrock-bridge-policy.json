{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:logs:us-east-1:772634497954:log-group:/aws/lambda/pf-voice-bedrock-bridge-dev:*"
        },
        {
            "Action": [
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:UpdateItem",
                "dynamodb:Query"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:dynamodb:us-east-1:772634497954:table/pf-session-data-dev"
        },
        {
            "Action": [
                "bedrock:InvokeAgent"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:bedrock:us-east-1:772634497954:agent/P9VCJXPIZS"
        }
    ]
}
