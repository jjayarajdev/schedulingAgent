      "name": "Scenario 1 - Negation/Exclusion Filters",
      "description": "Test exclusion queries: 'except', 'but not', 'excluding'",
      "item": [
        {
          "name": "1.1 Show all except scheduled",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.collectionVariables.set('s1_session', 'negation-' + Date.now());"],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response is successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Should NOT contain scheduled projects', function() {",
                  "    const jsonData = pm.response.json();",
                  "    const responseText = JSON.stringify(jsonData).toLowerCase();",
                  "    // Should show Ready To Schedule, not Scheduled",
                  "    pm.expect(responseText).to.include('ready');",
                  "});",
                  "",
                  "pm.test('Should contain Decking or Dishwasher (unscheduled)', function() {",
                  "    const jsonData = pm.response.json();",
                  "    const responseText = JSON.stringify(jsonData).toLowerCase();",
                  "    pm.expect(responseText).to.satisfy(function(text) {",
                  "        return text.includes('decking') || text.includes('dishwasher');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"message\": \"Show all my projects except the scheduled ones\",\n    \"session_id\": \"{{s1_session}}\",\n    \"pf_token\": \"{{access_token}}\",\n    \"pf_client_id\": \"{{client_id}}\",\n    \"pf_user_id\": \"{{user_id}}\",\n    \"stream\": false\n}"
