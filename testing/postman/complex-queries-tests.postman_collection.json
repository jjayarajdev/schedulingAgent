              "raw": "{{proxy_url}}/api/invoke-agent",
              "host": ["{{proxy_url}}"],
              "path": ["api", "invoke-agent"]
            },
            "description": "Expected: list_projects with exclude_status=['Scheduled']\\n\\nShould return: Decking, Dishwasher, Decking (Ready To Schedule)"
          }
