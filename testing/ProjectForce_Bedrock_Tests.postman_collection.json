  "item": [
    {
      "name": "1. Greeting & Chitchat",
      "item": [
        {
          "name": "1.1 Simple Greeting",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has output\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('output');",
                  "});",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(15000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"hello\",\n  \"session_id\": \"{{session_id}}-greeting-1\",\n  \"pf_token\": \"{{pf_token}}\",\n  \"pf_client_id\": \"{{pf_client_id}}\",\n  \"pf_user_id\": {{pf_user_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/invoke-agent",
              "host": ["{{base_url}}"],
              "path": ["invoke-agent"]
            },
            "description": "Expected: Supervisor → Chitchat Agent (~11s)"
          },
