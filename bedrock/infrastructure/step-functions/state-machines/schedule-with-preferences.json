{
  "Comment": "Conditional Scheduling with Preferences - Tries preferred times with fallback options",
  "StartAt": "ParsePreferences",
  "States": {
    "ParsePreferences": {
      "Type": "Pass",
      "Comment": "Parse scheduling preferences from input",
      "Parameters": {
        "project_id.$": "$.project_id",
        "customer_id.$": "$.customer_id",
        "client_id.$": "$.client_id",
        "sessionId.$": "$.sessionId",
        "preferences": {
          "first_choice.$": "$.preferences.first_choice",
          "second_choice.$": "$.preferences.second_choice",
          "show_alternatives.$": "$.preferences.show_alternatives"
        },
        "current_attempt": 1
      },
      "Next": "GetProjectDetails"
    },

    "GetProjectDetails": {
      "Type": "Task",
      "Comment": "Get project details to validate it exists",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "pf-information-actions",
        "Payload": {
          "apiPath": "/get_project_details",
          "httpMethod": "POST",
          "parameters": [
            {
              "name": "project_id",
              "value.$": "$.project_id"
            },
            {
              "name": "customer_id",
              "value.$": "$.customer_id"
            }
          ]
        }
      },
      "ResultPath": "$.projectResponse",
      "Next": "ParseProjectDetails",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleProjectError",
          "ResultPath": "$.error"
        }
      ]
    },

    "ParseProjectDetails": {
      "Type": "Pass",
      "Comment": "Extract project details from response",
      "Parameters": {
        "projectData.$": "States.StringToJson($.projectResponse.Payload.response.responseBody.application/json.body)",
        "preferences.$": "$.preferences",
        "customer_id.$": "$.customer_id",
        "client_id.$": "$.client_id",
        "sessionId.$": "$.sessionId",
        "current_attempt.$": "$.current_attempt"
      },
      "Next": "CheckFirstPreference"
    },

    "CheckFirstPreference": {
      "Type": "Pass",
      "Comment": "Simulate checking first preference availability (would call Scheduling Agent)",
      "Parameters": {
        "project.$": "$.projectData.project_details",
        "first_choice.$": "$.preferences.first_choice",
        "first_choice_available": true,
        "preferences.$": "$.preferences",
        "customer_id.$": "$.customer_id",
        "client_id.$": "$.client_id",
        "sessionId.$": "$.sessionId"
      },
      "Next": "IsFirstChoiceAvailable"
    },

    "IsFirstChoiceAvailable": {
      "Type": "Choice",
      "Comment": "Check if first preference is available",
      "Choices": [
        {
          "Variable": "$.first_choice_available",
          "BooleanEquals": true,
          "Next": "ScheduleFirstChoice"
        }
      ],
      "Default": "TrySecondChoice"
    },

    "ScheduleFirstChoice": {
      "Type": "Pass",
      "Comment": "Schedule using first preference",
      "Parameters": {
        "success": true,
        "scheduled": true,
        "project": {
          "id.$": "$.project.project_id",
          "category.$": "$.project.category",
          "address.$": "$.project.address.full_address"
        },
        "scheduled_slot": {
          "date.$": "$.first_choice.date",
          "time.$": "$.first_choice.time",
          "preference": "first_choice"
        },
        "message.$": "States.Format('Great news! Your first choice is available. Project {} scheduled for {} at {}.', $.project.project_id, $.first_choice.date, $.first_choice.time)",
        "nextStep": "Appointment confirmed! You'll receive a confirmation email shortly."
      },
      "End": true
    },

    "TrySecondChoice": {
      "Type": "Pass",
      "Comment": "Check second preference availability",
      "Parameters": {
        "project.$": "$.project",
        "first_choice.$": "$.preferences.first_choice",
        "second_choice.$": "$.preferences.second_choice",
        "second_choice_available": true,
        "preferences.$": "$.preferences",
        "customer_id.$": "$.customer_id",
        "client_id.$": "$.client_id",
        "sessionId.$": "$.sessionId"
      },
      "Next": "IsSecondChoiceAvailable"
    },

    "IsSecondChoiceAvailable": {
      "Type": "Choice",
      "Comment": "Check if second preference is available",
      "Choices": [
        {
          "Variable": "$.second_choice_available",
          "BooleanEquals": true,
          "Next": "ScheduleSecondChoice"
        }
      ],
      "Default": "ShowAlternatives"
    },

    "ScheduleSecondChoice": {
      "Type": "Pass",
      "Comment": "Schedule using second preference",
      "Parameters": {
        "success": true,
        "scheduled": true,
        "project": {
          "id.$": "$.project.project_id",
          "category.$": "$.project.category",
          "address.$": "$.project.address.full_address"
        },
        "scheduled_slot": {
          "date.$": "$.second_choice.date",
          "time.$": "$.second_choice.time",
          "preference": "second_choice"
        },
        "message.$": "States.Format('Your first choice wasn''t available, but your second choice works! Project {} scheduled for {} at {}.', $.project.project_id, $.second_choice.date, $.second_choice.time)",
        "nextStep": "Appointment confirmed! You'll receive a confirmation email shortly."
      },
      "End": true
    },

    "ShowAlternatives": {
      "Type": "Pass",
      "Comment": "Show alternative time slots",
      "Parameters": {
        "success": false,
        "scheduled": false,
        "project": {
          "id.$": "$.project.project_id",
          "category.$": "$.project.category",
          "address.$": "$.project.address.full_address"
        },
        "preferences_checked": {
          "first_choice.$": "$.first_choice",
          "second_choice.$": "$.second_choice"
        },
        "alternative_slots": [
          {
            "date": "2025-11-05",
            "time": "10:00 AM",
            "available": true
          },
          {
            "date": "2025-11-06",
            "time": "2:00 PM",
            "available": true
          },
          {
            "date": "2025-11-08",
            "time": "9:00 AM",
            "available": true
          }
        ],
        "message": "Unfortunately, neither of your preferred times are available. Here are the next available slots:",
        "nextStep": "Please choose one of these alternative times, or let me know your new preferences."
      },
      "End": true
    },

    "HandleProjectError": {
      "Type": "Pass",
      "Comment": "Handle error in getting project details",
      "Parameters": {
        "success": false,
        "error": "Failed to retrieve project details",
        "message": "I couldn't find that project. Please check the project ID and try again.",
        "project_id.$": "$.project_id",
        "details.$": "$.error"
      },
      "End": true
    }
  }
}
