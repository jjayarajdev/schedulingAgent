{
  "Comment": "Schedule Urgent Project Workflow - Finds most urgent project and schedules it for earliest available time",
  "StartAt": "GetAllProjects",
  "States": {
    "GetAllProjects": {
      "Type": "Task",
      "Comment": "Call Information Agent to get all customer projects",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "pf-information-actions",
        "Payload": {
          "apiPath": "/get_projects",
          "httpMethod": "POST",
          "parameters": [
            {
              "name": "customer_id",
              "value.$": "$.customer_id"
            }
          ]
        }
      },
      "ResultPath": "$.projectsResponse",
      "OutputPath": "$",
      "Next": "ParseProjectsResponse",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleGetProjectsError",
          "ResultPath": "$.error"
        }
      ]
    },

    "ParseProjectsResponse": {
      "Type": "Pass",
      "Comment": "Extract projects list from Lambda response",
      "Parameters": {
        "projects.$": "$.projectsResponse.Payload.response.responseBody.application/json.body",
        "customer_id.$": "$.customer_id",
        "client_id.$": "$.client_id",
        "sessionId.$": "$.sessionId",
        "query.$": "$.query"
      },
      "Next": "ParseProjectsJSON"
    },

    "ParseProjectsJSON": {
      "Type": "Pass",
      "Comment": "Parse the JSON string to extract projects array",
      "Parameters": {
        "projectsData.$": "States.StringToJson($.projects)",
        "customer_id.$": "$.customer_id",
        "client_id.$": "$.client_id",
        "sessionId.$": "$.sessionId",
        "query.$": "$.query"
      },
      "Next": "FilterUrgentProject"
    },

    "FilterUrgentProject": {
      "Type": "Task",
      "Comment": "Filter to find the most urgent project",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "pf-filter-projects",
        "Payload": {
          "projects.$": "$.projectsData.projects",
          "filterCriteria": "urgent"
        }
      },
      "ResultPath": "$.filterResult",
      "Next": "ParseFilterResult"
    },

    "ParseFilterResult": {
      "Type": "Pass",
      "Comment": "Parse filter result from JSON string",
      "Parameters": {
        "filterData.$": "States.StringToJson($.filterResult.Payload.body)",
        "customer_id.$": "$.customer_id",
        "client_id.$": "$.client_id",
        "sessionId.$": "$.sessionId",
        "query.$": "$.query",
        "projectsData.$": "$.projectsData"
      },
      "Next": "CheckIfUrgentFound"
    },

    "CheckIfUrgentFound": {
      "Type": "Choice",
      "Comment": "Check if we found an urgent project",
      "Choices": [
        {
          "Variable": "$.filterData.found",
          "BooleanEquals": true,
          "Next": "PrepareSchedulingRequest"
        }
      ],
      "Default": "NoUrgentProjects"
    },

    "PrepareSchedulingRequest": {
      "Type": "Pass",
      "Comment": "Prepare data for scheduling agent invocation",
      "Parameters": {
        "urgentProject.$": "$.filterData.mostUrgent",
        "customer_id.$": "$.customer_id",
        "client_id.$": "$.client_id",
        "sessionId.$": "$.sessionId"
      },
      "Next": "FormatSuccessResponse"
    },

    "FormatSuccessResponse": {
      "Type": "Pass",
      "Comment": "Format the final response for the user",
      "Parameters": {
        "success": true,
        "message.$": "States.Format('Found urgent project: {} ({}). Ready to schedule for earliest available time.', $.urgentProject.project_id, $.urgentProject.category)",
        "project": {
          "id.$": "$.urgentProject.project_id",
          "category.$": "$.urgentProject.category",
          "status.$": "$.urgentProject.status",
          "address.$": "$.urgentProject.address"
        },
        "nextStep": "Please confirm to proceed with scheduling, or I can show you available times first."
      },
      "End": true
    },

    "NoUrgentProjects": {
      "Type": "Pass",
      "Comment": "No urgent projects found",
      "Parameters": {
        "success": false,
        "message": "No urgent projects found. All your projects are on schedule. Would you like to schedule a regular appointment?",
        "projects_checked.$": "$.projectsData.projects"
      },
      "End": true
    },

    "HandleGetProjectsError": {
      "Type": "Pass",
      "Comment": "Handle error in getting projects",
      "Parameters": {
        "success": false,
        "error": "Failed to retrieve projects",
        "message": "I'm having trouble accessing your projects right now. Please try again in a moment.",
        "details.$": "$.error"
      },
      "End": true
    }
  }
}
