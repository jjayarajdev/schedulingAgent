# ProjectForce API Integration - Environment Variables
# Copy this file to .env and fill in your actual values

# ==============================================================================
# API MODE CONFIGURATION
# ==============================================================================

# Toggle between mock and real API
# Set to "false" to use real ProjectForce APIs
USE_MOCK_API=true

# Deployment environment (dev, staging, prod)
ENVIRONMENT=dev

# ==============================================================================
# AUTHENTICATION
# ==============================================================================

# ProjectForce Bearer Token
# Obtain from: https://projectsforce-validation.cx-portal.dev.projectsforce.com
# Token format: Long base64-encoded string (no "Bearer " prefix needed - added automatically)
BEARER_

# Default Client ID for ProjectForce
# This is used for all API calls unless overridden
DEFAULT_CLIENT_ID=09PF05VD

# ==============================================================================
# API ENDPOINTS (Optional - Auto-configured based on ENVIRONMENT)
# ==============================================================================

# Override API base URL if needed
# dev: https://api-cx-portal.dev.projectsforce.com
# staging: https://api-cx-portal.staging.projectsforce.com
# prod: https://api-cx-portal.projectsforce.com
# CUSTOMER_SCHEDULER_API_URL=https://api-cx-portal.dev.projectsforce.com

# ==============================================================================
# FEATURE FLAGS (Gradual Rollout)
# ==============================================================================

# Enable real API calls for specific actions
# Set to "true" to use real API, "false" to use mock data
ENABLE_REAL_CONFIRM=false
ENABLE_REAL_CANCEL=false

# ==============================================================================
# AWS CONFIGURATION
# ==============================================================================

# DynamoDB table for session management
DYNAMODB_TABLE=scheduling-agent-sessions-dev

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==============================================================================
# TESTING CREDENTIALS
# ==============================================================================

# Test Customer ID (from docs/api-calls.txt)
TEST_CUSTOMER_ID=1645869

# Test Project ID (from docs/api-calls.txt)
TEST_PROJECT_ID=7750176

# ==============================================================================
# NOTES FOR DEPLOYMENT
# ==============================================================================

# 1. For local testing:
#    - Copy this file to .env
#    - Set USE_MOCK_API=false
#    - Add your BEARER_TOKEN
#
# 2. For Lambda deployment:
#    - Set these as environment variables in Terraform
#    - Use AWS Secrets Manager for BEARER_TOKEN in production
#
# 3. Token refresh:
#    - Bearer tokens may expire
#    - Implement token refresh logic if needed
#    - Monitor 401 Unauthorized responses
#
# 4. Client ID mapping:
#    - Currently using single CLIENT_ID (09PF05VD)
#    - May need customer-to-client mapping for multi-tenant
