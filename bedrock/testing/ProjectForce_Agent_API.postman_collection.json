{
	"info": {
		"_postman_id": "scheduling-agent-api-v2",
		"name": "ProjectForce Scheduling Agent API",
		"description": "Complete API testing collection for ProjectForce Scheduling Agent with AWS Bedrock - Updated with Weather-Only Information Agent",
