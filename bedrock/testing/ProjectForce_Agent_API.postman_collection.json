	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Save access token for subsequent requests",
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    pm.environment.set('access_token', jsonData.data.access_token);",
									"    pm.environment.set('user_id', jsonData.data.user_id);",
									"    console.log('Access token saved:', jsonData.data.access_token.substring(0, 20) + '...');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"jay@mailinator.com\",\n    \"password\": \"Password@123\"\n}"
						},
						"url": {
							"raw": "{{proxy_url}}/api/login",
							"host": [
								"{{proxy_url}}"
							],
							"path": [
								"api",
								"login"
							]
						},
						"description": "Login to ProjectForce API and get access token"
					},
					"response": []
				},
				{
					"name": "Validate Token",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{proxy_url}}/api/validate-token?user_id={{user_id}}&identifier=projectsforce-validation",
							"host": [
								"{{proxy_url}}"
							],
							"path": [
								"api",
								"validate-token"
							],
							"query": [
								{
									"key": "user_id",
									"value": "{{user_id}}"
								},
								{
									"key": "identifier",
									"value": "projectsforce-validation"
								}
							]
						},
						"description": "Validate the access token"
					},
					"response": []
				}
			],
			"description": "Authentication endpoints for ProjectForce API"
		},
